# Nginx Proxy Manager Configuration
# Copy this file to .env and update the values

# ------------------------------------------------------------
# Generate secure passwords before deploying. Examples:
#   openssl rand -base64 32
#   openssl rand -hex 32
# ------------------------------------------------------------

# Database Configuration
# MYSQL_DATABASE and MYSQL_USER can remain 'npm' — they are not security-sensitive.
# MYSQL_ROOT_PASSWORD and MYSQL_PASSWORD MUST be set to strong, unique values.
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_DATABASE=npm
MYSQL_USER=npm
MYSQL_PASSWORD=your_secure_password_here
DB_MYSQL_PORT=3306

# Port Mappings
# HTTP port
HTTP_PORT=80
# HTTPS port
HTTPS_PORT=443
# Admin UI port
ADMIN_PORT=81
# Custom application ports (modify as needed)
CUSTOM_PORT_1=6690
CUSTOM_PORT_2=5000
CUSTOM_PORT_3=5001
