# Nginx Proxy Manager Configuration
# Copy this file to .env and update the values

# Database Configuration
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_DATABASE=npm
MYSQL_USER=npm
MYSQL_PASSWORD=your_secure_password_here
DB_MYSQL_PORT=3306

# Port Mappings
# HTTP port
HTTP_PORT=80
# HTTPS port
HTTPS_PORT=443
# Admin UI port
ADMIN_PORT=81
# Custom application ports (modify as needed)
CUSTOM_PORT_1=6690
CUSTOM_PORT_2=5000
CUSTOM_PORT_3=5001

# Docker Network
NETWORK_NAME=scoobydoo
