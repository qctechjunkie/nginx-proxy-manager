# Nginx Proxy Manager Configuration
# Copy this file to .env and update the values
#
# ------------------------------------------------------------
# DB_POSTGRES_PASSWORD must match the password provisioned for
# the 'npm' database/user in the shared global-postgres stack.
# ------------------------------------------------------------
DB_POSTGRES_HOST=global-postgres
DB_POSTGRES_PORT=5432
DB_POSTGRES_USER=npm
DB_POSTGRES_PASSWORD=your_secure_password_here
DB_POSTGRES_NAME=npm
HTTP_PORT=80
HTTPS_PORT=443
ADMIN_PORT=81
CUSTOM_PORT_1=6690
CUSTOM_PORT_2=5000
CUSTOM_PORT_3=5001
